[Unit]
Description=Stock Trader Bot
Documentation=file:///home/pi/trader-bot/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/trader-bot
EnvironmentFile=/home/pi/trader-bot/config.env

ExecStart=/home/pi/trader-bot/trader

# Restart on failure
Restart=on-failure
RestartSec=300

# Resource limits (sized for a Raspberry Pi)
MemoryLimit=500M
CPUQuota=75%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trader-bot

[Install]
WantedBy=multi-user.target
