# Stock Trader Bot - configuration
# Copy to config.env and source it before running:  source config.env

# ========== Entry rules ==========
# Minimum model confidence required to open or add to a position (0.0-1.0).
# 0.55 is permissive, 0.65 balanced, 0.75 conservative.
export ML_CONFIDENCE_THRESHOLD="0.65"

# Maximum share of total portfolio value any one position may reach (0.0-1.0).
# The bot will not buy past this, and the audit flags anything above it.
export RISK_THRESHOLD="0.25"

# ========== Exit rules ==========
# Close a position once it falls this far below its average cost (0.0-1.0).
# Set to 0 to disable.
export STOP_LOSS_PCT="0.15"

# Close a position once it rises this far above its average cost (0.0-1.0).
# Set to 0 to disable.
export TAKE_PROFIT_PCT="0.30"

# Also close a position when the model stops signalling a buy.
# Off by default: the classifier scores F1 0.42 / ROC-AUC 0.657 on its own test
# split, which is thin evidence on which to exit. Turn on only if you have
# backtested it and are satisfied it helps.
export ML_SELL_ENABLED="0"

# Confidence required for a model-driven exit, when the above is enabled.
export ML_SELL_CONFIDENCE="0.70"

# ========== Safety ==========
# Evaluate and print without writing portfolio_state.json or the trade log.
# Equivalent to passing --dry-run.
export DRY_RUN="0"

# ========== Paths ==========
# Python interpreter used for model inference. Leave unset to use python3.
# export PYTHON_BIN="/path/to/venv/bin/python"

# ========== Legacy version only ==========
# Needed only by legacy-alphavantage.cpp, which trader.cpp replaces.
# Free key: https://www.alphavantage.co/  (free tier: 5 requests per minute)
export ALPHAVANTAGE_API_KEY=""

# ========== Systemd ==========
# sudo cp trader-bot.service /etc/systemd/system/
# sudo systemctl enable --now trader-bot.service
