# ---------------------------------------------------------------------------
# OpenAI (optional — everything except AI research and Discover works without it)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY: read only by the server — the dev server (`npm run dev`) and
# server.ts (`npm run serve`) both relay AI requests through aiRelay.ts. The key
# is never compiled into the page. Don't add a VITE_ prefix: anything with one
# is shipped to the browser, where anyone loading the page can read it.
OPENAI_API_KEY=""

# Optional model override.
OPENAI_MODEL="gpt-4.1-mini"

# Optional: AI requests each visitor may make per 15 minutes (default 30).
# AI_REQUESTS_PER_WINDOW="30"

# Port for server.ts (default 8080).
PORT="8080"

# APP_URL: where this applet is hosted. AI Studio injects this at runtime with
# the Cloud Run service URL. Used for self-referential links and OAuth callbacks.
APP_URL="MY_APP_URL"
