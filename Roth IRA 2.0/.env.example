# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
# VITE_OPENAI_API_KEY: read by the browser for AI features during `npm run dev`.
#
# WARNING: anything prefixed with VITE_ is compiled into the client bundle and
# is readable by anyone who loads the page. Use this for local development only.
# For anything hosted, leave it unset and use OPENAI_API_KEY below instead.
VITE_OPENAI_API_KEY="MY_OPENAI_API_KEY"

# Optional model override for the client-side path.
VITE_OPENAI_MODEL="gpt-4.1-mini"

# ---------------------------------------------------------------------------
# Production (npm run build && npm run serve)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY: read by server.ts only. The key stays on the server and the
# browser calls /api/ai/chat instead of OpenAI directly, so the key is never
# shipped to the client. No VITE_ prefix — that is the whole point.
OPENAI_API_KEY=""

# Optional model override for the server relay.
OPENAI_MODEL="gpt-4.1-mini"

# Port for server.ts (default 8080).
PORT="8080"

# APP_URL: where this applet is hosted. AI Studio injects this at runtime with
# the Cloud Run service URL. Used for self-referential links and OAuth callbacks.
APP_URL="MY_APP_URL"
