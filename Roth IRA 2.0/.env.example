# OpenAI API key — kept server-side only, never exposed to the browser.
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# Optional: override the OpenAI model (default: gpt-4.1-mini)
OPENAI_MODEL="gpt-4.1-mini"

# Port for the local proxy server (default: 3001)
PROXY_PORT=3001

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
